{
    "requires": {
        "cockpit": "266"
    },

    "conditions": [
        {"any": [
            {"path-exists": "/usr/bin/docker"},
            {"path-exists": "/usr/local/bin/docker"},
            {"path-exists": "/snap/bin/docker"}
        ]}
    ],

    "config": {
        "name-prefixes": [],
        "label-selectors": ["cockpit.app-health=true"]
    },

    "menu": {
        "index": {
            "label": "Application Health",
            "order": 45,
            "keywords": [
                {
                    "matches": ["docker", "container", "app", "health", "monitor"]
                }
            ]
        }
    }
}
